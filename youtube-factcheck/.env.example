# Anthropic API key — used for claim extraction and fact-checking with web search.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model used for extraction and verification.
# Defaults to claude-sonnet-5.
# FACTCHECK_MODEL=claude-sonnet-5

# Optional: port the Express API listens on (default 8787).
# PORT=8787
